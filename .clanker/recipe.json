{
  "version": 1,
  "requires": [
    { "name": "Node 24", "check": "node -e \"process.exit(Number(process.versions.node.split('.')[0]) >= 24 ? 0 : 1)\"" },
    { "name": "npm", "check": "npm --version" }
  ],
  "setup": {
    "worktree": ["npm ci --silent"]
  },
  "commands": {
    "typecheck": "npm run -s typecheck",
    "lint": "npm run -s lint",
    "test:related": "npx vitest related --run --passWithNoTests --testTimeout=30000 {{files}}",
    "test": "npx vitest run --passWithNoTests --testTimeout=30000 {{files}}",
    "test:full": "npx vitest run --maxWorkers=3 --testTimeout=30000"
  },
  "checks": ["typecheck", "lint", "test:related", "test:full"]
}
