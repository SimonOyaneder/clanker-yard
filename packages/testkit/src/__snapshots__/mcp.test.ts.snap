      ],
      "type": "object",
    },
    "name": "request_local_pr_publish",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
    },
    "description": "Abre el chat vigente por id interno del PR y devuelve sus mensajes y última propuesta. Si aún no hay chat, crea uno vacío sin iniciar un turno.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "prId": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "prId",
      ],
      "type": "object",
    },
    "name": "get_pr_chat",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true,
    },
    "description": "Envía un mensaje al chat y lanza un turno del agente. El turno usa cuota del proveedor y puede modificar el borrador aislado, pero no aplica la propuesta al PR. Consulta \`get_pr_chat\` para ver la respuesta y la propuesta.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "chatId": {
          "pattern": "^chat_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string",
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
          ],
          "type": "string",
        },
        "model": {
          "minLength": 1,
          "type": "string",
        },
        "refs": {
          "items": {
            "oneOf": [
              {
                "properties": {
                  "end": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "kind": {
                    "const": "lines",
                    "type": "string",
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "start": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "text": {
                    "type": "string",
                  },
                },
                "required": [
                  "kind",
                  "path",
                  "start",
                  "end",
                  "text",
                ],
                "type": "object",
              },
              {
                "properties": {
                  "author": {
                    "type": "string",
                  },
                  "id": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "kind": {
                    "const": "thread",
                    "type": "string",
                  },
                  "line": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer",
                  },
                  "path": {
                    "type": "string",
                  },
                  "text": {
                    "type": "string",
                  },
                },
                "required": [
                  "kind",
                  "id",
                  "text",
                ],
                "type": "object",
              },
            ],
          },
          "maxItems": 20,
          "type": "array",
        },
        "runtime": {
          "enum": [
            "claude-sdk",
            "opencode",
            "codex",
          ],
          "type": "string",
        },
        "text": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "chatId",
        "text",
      ],
      "type": "object",
    },
    "name": "send_pr_chat_message",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
    },
    "description": "Interrumpe el turno en curso del chat sin aplicar su propuesta al PR. Devuelve un error si no hay un turno en curso.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "chatId": {
          "pattern": "^chat_[0-9A-HJKMNP-TV-Z]{26}$",
