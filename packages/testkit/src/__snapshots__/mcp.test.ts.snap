  {
    "annotations": {
      "openWorldHint": true,
      "readOnlyHint": true,
    },
    "description": "Lee el título, cuerpo, puntas, commits, archivos y diff de un PR por su id interno (\`list_prs\`). Sirve a PRs locales y publicados; si está publicado, consulta GitHub y trae los commits faltantes. \`truncated\` indica si se recortó el diff.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "get_pr_detail",
  },
  {
    "annotations": {
      "openWorldHint": true,
      "readOnlyHint": true,
    },
    "description": "Lee el diff de un commit de un PR por su id interno y SHA. Pasa \`head\` y \`base\` (el \`baseSha\` de \`get_pr_detail\`) para comprobar que el PR no cambió. En PRs publicados puede consultar GitHub y traer los commits faltantes.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "base": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string",
        },
        "head": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string",
        },
        "id": {
          "minLength": 1,
          "type": "string",
        },
        "sha": {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string",
        },
      },
      "required": [
        "id",
        "sha",
        "head",
        "base",
      ],
      "type": "object",
    },
    "name": "get_pr_commit_diff",
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Lee título, descripción, ramas, SHA, commits, archivos y diff de un PR local por su id interno. \`truncated\` indica si el diff supera el límite; se puede consultar por commit.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "get_local_pr",
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Lee el diff de un commit de un PR local por id interno y SHA. Rechaza commits ajenos al PR.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string",
        },
        "sha": {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string",
        },
      },
      "required": [
        "id",
        "sha",
      ],
      "type": "object",
    },
    "name": "get_local_pr_commit_diff",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
    },
    "description": "Edita el título y/o la descripción de un PR local por id interno. Una descripción vacía la borra. No cambia commits ni publica.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 65536,
          "type": "string",
        },
        "id": {
          "minLength": 1,
          "type": "string",
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "update_local_pr",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
    },
    "description": "Encola una corrida que agrega un commit a un PR local a partir de un diff unificado. Requiere el SHA \`head\` de \`get_local_pr\` y un worktree limpio. No reescribe commits ni hace push. Consulta la corrida por su id.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "head": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string",
        },
        "id": {
          "minLength": 1,
          "type": "string",
        },
        "patch": {
          "maxLength": 2000000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "id",
        "head",
        "patch",
      ],
      "type": "object",
    },
    "name": "apply_local_pr_patch",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
    },
    "description": "Solicita publicar un PR local por id interno. Devuelve una decisión que una persona debe aprobar en la Bandeja de la app. La solicitud no hace push ni crea un PR en GitHub.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
