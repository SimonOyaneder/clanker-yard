{
  "name": "@clanker/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build -w @clanker/core && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "icon": "scripts/build-icon.sh",
    "e2e": "npm run build -w @clanker/core && electron-vite build && playwright test",
    "build:mac": "npm run build -w @clanker/core && npm run build -w @clanker/cli && electron-vite build && electron-builder --mac -c.electronVersion=$(node -p \"require('electron/package.json').version\")"
  },
  "dependencies": { "@clanker/api": "*", "@clanker/ui": "*" },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  }
}
