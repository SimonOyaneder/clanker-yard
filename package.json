{
  "name": "clanker-yard",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && npm run depcheck && npm run -s db:check -w @clanker/core",
    "test": "vitest run",
    "depcheck": "depcruise apps packages --config .dependency-cruiser.mjs",
    "e2e": "npm run e2e -w @clanker/desktop",
    "build:mac": "npm run build:mac -w @clanker/desktop",
    "install:mac": "npm run build:mac && apps/desktop/scripts/install-app.sh"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
