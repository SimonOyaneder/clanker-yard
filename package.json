{
  "name": "clanker-yard",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && npm run depcheck",
    "test": "vitest run",
    "depcheck": "depcruise apps packages --config .dependency-cruiser.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
